# Скопировать в .env и заполнить. Сам .env в репозиторий не коммитить.

# --- Провайдер LLM ---
# Эндпоинты NVIDIA NIM совместимы с OpenAI, поэтому провайдер
# переключается base_url и ключом, без правки кода.

LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=

# --- Приложение ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

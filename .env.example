# Скопировать в .env и заполнить. Сам .env в репозиторий не коммитить.

# --- Провайдер LLM ---
# Эндпоинты NVIDIA NIM совместимы с OpenAI, поэтому провайдер
# переключается base_url и ключом, без правки кода.

LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# --- Приложение ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Данные ---
# Файл состояния. Если отсутствует — создаётся из data/seed.json при старте.
DATA_PATH=data/store.json
SEED_PATH=data/seed.json
